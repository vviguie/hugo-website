@article{creutzig_2026_WheelsSystemsCharacterizing,
 abstract = {Automobility's global role in providing mobility services but with adverse impacts on climate change and land use makes it a critical topic at a planetary scale. So far the role of cars has been mostly addressed from a techno-economic perspective, with complementary but fragmented insights from other social sciences. We provide evidence that understanding automobility as a sub-system of the technosphere compromising human-made artifacts and structures with impacts at planetary scale enables investigations from a systems perspective. Our empirically grounded characterization of causal loops provides insights on intervention points guiding co-evolutionary trajectories between automobility, societies, and local and planetary dynamics along different temporal and spatial scales. We systematically draw on existing modeling approaches for outlining how to model automobility as technosphere in a reduced form. We conclude that policies, measures and cultural shifts should be systematically evaluated according to their impact on car-dependent systems. Our approach offers novel insights for reorienting automobility toward pathways consistent with low planetary impact and high well-being.},
 author = {Creutzig, Felix and Wells, Peter and Wagner, Felix and Aguilar Jaber, Aimée and Andor, Mark and Arnz, Marlin and Bamberg, Sebastian and Cohen-Blankshtain, Galit and Broaddus, Andrea and Dütschke, Elisabeth and Gössling, Stefan and Hopkins, Debbie and Javaid, Aneeque and Keil, A. Katharina and Mattioli, Giulio and Millard-Ball, Adam and Miller, Eric J. and Mouratidis, Kostas and Nachtigall, Florian and Pozoukidou, Georgia and Ramakrishnan, Anjali and Rau, Henrike and Renn, Jürgen and Steudle, Gesine and Viguié, Vincent and Vogl, Malte and Wiedenhofer, Dominik and Wilson, Charlie and Wolf, Sarah and Yeh, Sonia and Zimm, Caroline},
 doi = {10.1177/20530196261472905},
 issn = {2053-0196},
 journal = {The Anthropocene Review},
 langid = {english},
 month = {October},
 pages = {20530196261472905},
 publisher = {SAGE Publications},
 shorttitle = {From Wheels to Systems},
 title = {From Wheels to Systems: Characterizing Automobility as Technosphere},
 urldate = {2026-11-09},
 year = {2026}
}
